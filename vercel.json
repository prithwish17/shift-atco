{
  "functions": {
    "api/supabase/*.ts": { "maxDuration": 60 },
    "api/functions/*.ts": { "maxDuration": 60 },
    "api/upload/profile-picture.ts": { "maxDuration": 30 },
    "api/upload/leave-document.ts": { "maxDuration": 30 },
    "api/leave/*.ts": { "maxDuration": 30 },
    "api/working-hours.ts": { "maxDuration": 60 },
    "api/metrics.ts": { "maxDuration": 30 },
    "api/night-allocation/*.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/supabase/(.*)",
      "destination": "/api/supabase/[...path]?path=$1"
    },
    {
      "source": "/api/functions/(.*)",
      "destination": "/api/functions/[...path]?path=$1"
    },
    {
      "source": "/api/leave-document-url",
      "destination": "/api/leave/[...route]?route=document-url"
    },
    {
      "source": "/api/leave-roster",
      "destination": "/api/leave/[...route]?route=roster"
    },
    {
      "source": "/api/leave-sheet-push",
      "destination": "/api/leave/[...route]?route=sheet-push"
    },
    {
      "source": "/api/night-allocation/(.*)",
      "destination": "/api/night-allocation/[...route]?route=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
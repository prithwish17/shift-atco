{
  "rewrites": [
    {
      "source": "/api/supabase/(.*)",
      "destination": "/api/supabase/[...path]?path=$1"
    },
    {
      "source": "/api/functions/(.*)",
      "destination": "/api/functions/[...path]?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}